# MongoDB Atlas connection string. Keep this server-only; never use a NEXT_PUBLIC_ prefix.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DB=smartlib

# Use a long random value (at least 32 characters). Required for production sessions.
SESSION_SECRET=replace-with-a-long-random-secret

# Optional: set to 1 to disable the browser's sample-data preview.
REQUIRE_DATABASE=0
