# MongoDB Atlas connection string. Keep this server-only; never use a NEXT_PUBLIC_ prefix.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DB=smartlib

# Use a long random value (at least 32 characters). Required for production sessions.
SESSION_SECRET=replace-with-a-long-random-secret

# Live data is required; the app does not fall back to browser sample data.
REQUIRE_DATABASE=1

# First administrator setup. Add a separate random token of at least 32 characters
# as INITIAL_ADMIN_SETUP_TOKEN in Vercel; never commit the token to this file.
INITIAL_ADMIN_NAME=Your Name
INITIAL_ADMIN_EMAIL=you@example.com
# Only needed when migrating an existing administrator to the new email.
INITIAL_ADMIN_PREVIOUS_EMAIL=old-admin@example.com
INITIAL_ADMIN_SETUP_TOKEN=replace-with-a-random-token-of-at-least-32-characters
